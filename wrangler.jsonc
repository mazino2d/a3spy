{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a3spy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The web app (web/, built to web/dist). The Worker runs first only for its own routes.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhook", "/healthz", "/luat"]
  },
  "vars": { "REALTIME_APP_ID": "2578aff8745a85e8333679f34f814cb9" },
  // Secrets (set by CD, never committed): TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, REALTIME_APP_TOKEN, OWNER_TELEGRAM_ID
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoomDO" },
      { "name": "GUEST", "class_name": "GuestDO" },
      { "name": "LEADERBOARD", "class_name": "LeaderboardDO" },
      { "name": "AUDIENCE", "class_name": "AudienceDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO", "PlayerDO"] },
    { "tag": "v2", "new_sqlite_classes": ["StatsDO"] },
    { "tag": "v3", "new_sqlite_classes": ["AudienceDO"] },
    // M7 cutover: delete every room, guest and stat from before the move to the web,
    // and start over with empty classes. AudienceDO (the announcement list) is kept.
    { "tag": "v4", "deleted_classes": ["RoomDO", "PlayerDO", "StatsDO"] },
    { "tag": "v5", "new_sqlite_classes": ["GameRoomDO", "GuestDO", "LeaderboardDO"] }
  ]
}
