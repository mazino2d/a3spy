{
  "name": "a3spy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p web",
    "check": "npm run lint && npm run typecheck && npm run build:web && npm test",
    "cf-typegen": "wrangler types --include-runtime false",
    "telegram:profile": "node scripts/sync-telegram-profile.ts",
    "avatar": "node scripts/render-avatar.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/oswald": "5.2.8",
    "grammy": "1.46.0",
    "preact": "10.29.8",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261012.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.12.0",
    "jpeg-js": "0.4.4",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261006.1": true,
    "fsevents": false
  }
}
